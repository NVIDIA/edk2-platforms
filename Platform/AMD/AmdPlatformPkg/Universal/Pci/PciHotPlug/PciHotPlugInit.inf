[Defines]
  INF_VERSION                    = 1.29
  BASE_NAME                      = PciHotPlugInit
  FILE_GUID                      = 85F78A6D-6438-4BCC-B796-759A48D00C72
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 0.1
  ENTRY_POINT                    = PciHotPlugInitialize

[Sources]
  PciHotPlugInit.c

[Packages]
  AmdPlatformPkg/AmdPlatformPkg.dec
  MdeModulePkg/MdeModulePkg.dec
  MdePkg/MdePkg.dec
  AgesaModulePkg/AgesaCommonModulePkg.dec
  AgesaModulePkg/AgesaModuleNbioPkg.dec

[LibraryClasses]
  MemoryAllocationLib
  UefiBootServicesTableLib
  UefiDriverEntryPoint

[Protocols]
  gEfiPciHotPlugInitProtocolGuid

[Pcd]
  gAmdPlatformPkgTokenSpaceGuid.PcdPciHotPlugResourcePadBus
  gAmdPlatformPkgTokenSpaceGuid.PcdPciHotPlugResourcePadIo
  gAmdPlatformPkgTokenSpaceGuid.PcdPciHotPlugResourcePadMem
  gAmdPlatformPkgTokenSpaceGuid.PcdPciHotPlugResourcePadPMem
  gEfiAmdAgesaModulePkgTokenSpaceGuid.PcdValLoopbackMode

[Depex]
  TRUE
